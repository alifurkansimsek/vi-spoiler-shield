{
  "manifest_version": 3,
  "name": "Spoiler Kalkanı",
  "version": "1.1.0",
  "description": "GTA 6 ile ilgili metin, görsel ve videoları tarayıcıda otomatik olarak gizler.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "declarativeNetRequest", "contextMenus", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Spoiler Kalkanı",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_page": "ui/options.html",
  "web_accessible_resources": [{
    "resources": ["ui/blocked.html", "ui/blocked.js", "ui/theme.css", "ui/fonts.css", "ui/fonts/*", "ui/logo.svg", "ui/icons.svg"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "css": ["css/content.css"],
      "js": ["src/dictionary.js", "src/matcher.js", "src/hash.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
